{
	"name": "paplico-root",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"packageManager": "yarn@4.17.1",
	"workspaces": [
		"pkgs/*"
	],
	"scripts": {
		"dev": "run-s dev:supabase dev:app",
		"dev:supabase": "cd pkgs/web && (supabase status > /dev/null 2>&1 || supabase start)",
		"dev:app": "cd pkgs/web && yarn dev",
		"db:status": "yarn workspace pap db:status",
		"db:start": "yarn workspace pap db:start",
		"db:reset": "yarn workspace pap db:reset",
		"db:stop": "yarn workspace pap db:stop",
		"build": "yarn workspace pap build",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"lint:unused": "tsx scripts/lint-unused.ts",
		"licenses:update": "tsx scripts/gen-dependency-licenses.ts",
		"licenses:check": "tsx scripts/gen-dependency-licenses.ts --check",
		"check-dev-server": "./scripts/check-dev-server",
		"publish:public": "./scripts/publish-public.sh",
		"desktop:dev": "yarn workspace @paplico/desktop dev",
		"desktop:build": "yarn workspace @paplico/desktop build",
		"desktop:dev:ios": "yarn workspace @paplico/desktop dev:ios",
		"desktop:build:ios": "yarn workspace @paplico/desktop build:ios"
	},
	"volta": {
		"node": "24.13.0",
		"yarn": "4.17.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"lefthook": "^2.1.1",
		"npm-run-all2": "^8.0.4",
		"ts-morph": "^28.0.0",
		"tsx": "^4.23.1"
	}
}
