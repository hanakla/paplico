{
	"compilerOptions": {
		"target": "ES2025",
		"strictNullChecks": true,
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": false,
		"noEmit": true,
		"incremental": true,
		"module": "esnext",
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": [
			"@webgpu/types",
			"@types/wicg-file-system-access",
			"vitest/globals"
		],
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": [
		"next-env.d.ts",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts",
		"**/*.ts",
		"**/*.tsx",
		"**/*.mdx"
	],
	"exclude": ["node_modules"]
}
