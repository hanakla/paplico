# Supabase
# Local: http://127.0.0.1:54321
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# HS256 symmetric key for JWT verification (used by PartyKit server)
# Local: super-secret-jwt-token-with-at-least-32-characters-long
# Remote: Supabase Dashboard > Project Settings > API > JWT Secret (plain text string, not base64)
SUPABASE_JWT_SECRET=

# Supabase Auth OAuth (for cloud mode)
# SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
# SUPABASE_AUTH_EXTERNAL_X_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_X_SECRET=

# Tauri production only
# NEXT_PUBLIC_API_BASE_URL=https://paplico.hanak.la

NEXT_PUBLIC_GOOGLE_FONTS_API_KEY=

# Room signing secret for HMAC-signed room creation tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROOM_SIGNING_SECRET=

# Collaboration mode: "local" (default) or "cloud"
# NEXT_PUBLIC_COLLAB_MODE=cloud

# Cloud mode only: PartyKit WebSocket
# NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999

# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
