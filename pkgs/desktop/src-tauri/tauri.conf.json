{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Paplico",
	"version": "0.0.0",
	"identifier": "la.hanak.paplico-app",
	"build": {
		"beforeDevCommand": "yarn workspace pap dev:tauri",
		"devUrl": "https://localhost:5005",
		"beforeBuildCommand": "yarn workspace pap build:tauri",
		"frontendDist": "../../web/out"
	},
	"app": {
		"windows": [
			{
				"title": "Paplico",
				"width": 1280,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"dragDropEnabled": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"userAgent": "PaplicoDesktop",
				"trafficLightPosition": { "x": 16, "y": 21 }
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' wss://localhost:* https://localhost:* wss://*.partykit.dev https://*.partykit.dev https://www.googleapis.com https://*.clerk.accounts.dev https://*.sentry.io"
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["paplico"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
