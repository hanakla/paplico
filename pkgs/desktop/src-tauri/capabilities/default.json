{
	"identifier": "default",
	"description": "Default capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:allow-start-dragging",
		"safe-area-insets-css:default",
		"fs:allow-read-file",
		"fs:allow-write-file",
		{
			"identifier": "fs:allow-exists",
			"allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/config.yml" }]
		},
		{
			"identifier": "fs:allow-mkdir",
			"allow": [{ "path": "$APPDATA" }]
		},
		{
			"identifier": "fs:allow-read-text-file",
			"allow": [{ "path": "$APPDATA/config.yml" }]
		},
		{
			"identifier": "fs:allow-write-text-file",
			"allow": [{ "path": "$APPDATA/config.yml" }]
		},
		"dialog:default",
		"dialog:allow-open",
		"dialog:allow-save",
		"sql:default",
		"sql:allow-execute",
		"deep-link:default",
		"opener:allow-default-urls",
		"opener:allow-open-url",
		"opener:default",
		"oauth:allow-start",
		"oauth:allow-cancel",
		"system-fonts:default"
	]
}
