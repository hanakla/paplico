{
	"name": "@paplico/syrup",
	"version": "0.1.0",
	"description": "Syrup: a Swift-flavored, statically typed scripting language that compiles to JavaScript",
	"type": "module",
	"license": "MIT",
	"author": "Hanakla <hanakla.dev@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/hanakla/paplico",
		"directory": "pkgs/syrup"
	},
	"files": [
		"dist",
		"README.md",
		"specification.md"
	],
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./worker": {
			"import": "./src/runner/workerEntry.ts",
			"types": "./src/runner/workerEntry.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"import": "./dist/index.mjs"
			},
			"./worker": {
				"types": "./dist/runner/workerEntry.d.mts",
				"import": "./dist/runner/workerEntry.mjs"
			}
		}
	},
	"scripts": {
		"playground": "vite playground",
		"build": "tsdown",
		"prepublishOnly": "yarn build",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"chevrotain": "^12.0.0"
	},
	"peerDependencies": {
		"monaco-editor": "^0.55.1"
	},
	"peerDependenciesMeta": {
		"monaco-editor": {
			"optional": true
		}
	},
	"devDependencies": {
		"monaco-editor": "^0.55.1",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
